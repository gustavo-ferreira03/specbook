{
    "name": "@specbook/runtime",
    "version": "0.1.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && esbuild src/specbook/fixtures.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/specbook-fixtures.mjs && node scripts/copy-assets.mjs",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@babel/parser": "7.29.9",
        "@playwright/test": "1.62.0",
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@babel/types": "7.29.8",
        "@types/node": "^26.6.4",
        "esbuild": "^0.28.2",
        "typescript": "7.0.2"
    }
}
