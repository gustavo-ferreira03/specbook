{
    "name": "backend",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "node scripts/build.mjs",
        "browser:install": "node scripts/install-browsers.mjs",
        "browser:install:docker": "node scripts/install-browsers.mjs --with-deps",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node --import tsx scripts/migrate.mjs",
        "start": "node dist/index.js",
        "test": "node --import tsx --test \"test/**/*.test.ts\"",
        "typecheck": "tsc --noEmit",
        "ops": "node dist/operations-cli.js"
    },
    "dependencies": {
        "@babel/parser": "7.29.9",
        "@earendil-works/pi-ai": "1.0.4",
        "@earendil-works/pi-coding-agent": "1.0.4",
        "@hono/node-server": "^1.19.14",
        "@hono/zod-validator": "^0.9.0",
        "@libsql/client": "^0.17.3",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@playwright/mcp": "0.0.78",
        "@playwright/test": "1.62.0",
        "axe-core": "^4.14.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "gray-matter": "^4.0.3",
        "hono": "^4.13.1",
        "openid-client": "^6.8.8",
        "playwright-core": "1.62.0",
        "simple-git": "^4.0.2",
        "ws": "^8.21.0",
        "yaml": "^2.9.0",
        "zod": "^4.4.3",
        "@specbook/runtime": "workspace:*"
    },
    "devDependencies": {
        "@babel/types": "7.29.8",
        "@types/node": "^26.6.4",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "^0.31.11",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.15",
        "typescript": "7.0.2"
    }
}
