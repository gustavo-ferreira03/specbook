{
    "name": "backend",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js && esbuild src/core/runner/specbook/fixtures.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/specbook-fixtures.mjs && mkdir -p dist/prompts && cp src/core/chat/prompts/* dist/prompts/",
        "browser:install": "node scripts/install-browsers.mjs",
        "browser:install:docker": "node scripts/install-browsers.mjs --with-deps",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "start": "node dist/index.js",
        "test": "node --import tsx --test \"test/**/*.test.ts\"",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@babel/parser": "7.29.9",
        "@earendil-works/pi-ai": "0.80.10",
        "@earendil-works/pi-coding-agent": "0.80.10",
        "@hono/node-server": "^1.19.14",
        "@hono/zod-validator": "^0.8.0",
        "@libsql/client": "^0.17.3",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@playwright/mcp": "0.0.78",
        "@playwright/test": "1.62.0",
        "axe-core": "^4.14.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "gray-matter": "^4.0.3",
        "hono": "^4.12.23",
        "playwright-core": "1.62.0",
        "simple-git": "^3.36.0",
        "ws": "^8.21.0",
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@babel/types": "7.29.8",
        "@types/node": "^26.1.2",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "^0.31.10",
        "esbuild": "^0.28.1",
        "tsx": "^4.7.1",
        "typescript": "7.0.2"
    }
}
